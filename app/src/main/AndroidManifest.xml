<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:forceDarkAllowed="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_ufps"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_ufps_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuCarnetApp">
        <activity
            android:name=".ui.home.HomeScreenActivity"
            android:exported="true" />
        <activity
            android:name=".ui.liveness.FaceLivenessActivity"
            android:exported="false" />
        <activity
            android:name=".ui.terms.TermsConditionsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.LoadingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.StudentProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.QRScannerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.LoadScreenActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TuCarnetApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>