<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar verificación facial"
        android:textSize="24sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/ufps_texto_principal"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Mensaje -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ahora iniciaremos el proceso de reconocimiento facial utilizando Amazon Rekognition.\n\nAsegúrate de estar en un lugar con buena iluminación. Este proceso solo tomará unos segundos."
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/ufps_texto_oscuro"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Botón Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/PrincipalWhiteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/ufps_texto_principal"
            android:layout_marginEnd="8dp" />

        <!-- Botón Confirmar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/PrincipalRedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Continuar"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
