<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enviar foto"
        android:textSize="24sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/ufps_texto_principal"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Imagen seleccionada -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPreview"
        android:layout_width="160dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:layout_marginBottom="16dp"
        android:background="@drawable/no_image" />

    <!-- Mensaje -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Estás seguro de que deseas enviar esta foto para validación?\n\nNo podrás cambiarla nuevamente hasta que finalice el proceso."
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/ufps_texto_oscuro"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/PrincipalWhiteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/ufps_texto_principal"
            android:layout_marginEnd="8dp" />

        <!-- Confirmar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/PrincipalRedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enviar foto"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
