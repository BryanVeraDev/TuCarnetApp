<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/ufps_blanco_favorito">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp">

            <!-- Mensaje de validación -->
            <TextView
                android:id="@+id/textValidationMessage"
                style="@style/DefaultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Intento 1 de 3"
                android:textColor="@color/ufps_informacion_oscuro"
                android:background="@color/ufps_informacion_claro"
                android:padding="12dp"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Imagen circular + botón editar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/no_image" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/PrincipalBlueButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Subir foto"
                    app:icon="@drawable/camera_icon"
                    app:iconSize="18dp" />

            </LinearLayout>

            <!-- Botonera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="32dp">

                <!-- Botón Regresar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoHome"
                    style="@style/PrincipalRedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Regresar"
                    android:layout_marginEnd="16dp" />   <!-- 👈 ESPACIO ENTRE BOTONES -->

                <!-- Botón Confirmar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmPhoto"
                    style="@style/PrincipalBlueButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Confirmar foto" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
